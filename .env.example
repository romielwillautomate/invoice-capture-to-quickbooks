# Gmail, Google Sheets and QuickBooks are connected through n8n credentials (OAuth), not through this file.
# See docs/setup.md. Everything below goes into the n8n environment.

# Gmail labels, by name. Create all five in Gmail first; nested labels use a slash.
GMAIL_LABEL_TO_PROCESS=Invoices/To Process
GMAIL_LABEL_AWAITING=Invoices/Awaiting Approval
GMAIL_LABEL_PROCESSED=Invoices/Processed
GMAIL_LABEL_REJECTED=Invoices/Rejected
GMAIL_LABEL_NEEDS_REVIEW=Invoices/Needs Review

# QuickBooks Online. Sandbox: https://sandbox-quickbooks.api.intuit.com and https://app.sandbox.qbo.intuit.com
QBO_BASE_URL=https://quickbooks.api.intuit.com
QBO_APP_URL=https://app.qbo.intuit.com
# The company ID (Realm ID) of the company the QuickBooks credential is connected to
QBO_REALM_ID=1234567890123456
# Expense account for the invoice lines, and the account for the tax line (defaults to the expense account)
QBO_EXPENSE_ACCOUNT_ID=7
QBO_TAX_ACCOUNT_ID=
HOME_CURRENCY=USD
# Optional: names as they appear on invoices, mapped to the QuickBooks vendor display name
VENDOR_ALIASES={"Northwind Office Supply Inc.": "Northwind Office Supply"}

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Default claude-sonnet-5. claude-haiku-4-5 is cheaper, claude-opus-5 also works. The Claude Fable and Mythos models and
# claude-opus-5-5 refuse the forced tool call with thinking turned off, so a run refuses to start with them.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: your business name, used in the instructions for Claude
BUSINESS_NAME=Maple Street Bakery

# Approval links
# A random string of at least 32 characters. It signs every link; change it and all open links stop working.
APPROVAL_SECRET=make-up-a-long-random-string-of-at-least-32-characters
# The production URL of the approval webhook in this workflow
APPROVAL_BASE_URL=https://n8n.example.com/webhook/invoice-approval
APPROVAL_LINK_DAYS=7

# Slack incoming webhook for approval requests, notes and error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# The ID of the n8n data table that keeps the invoice ledger (columns are listed in docs/setup.md)
LEDGER_TABLE_ID=your-data-table-id

# Optional: Google Sheet for the log (the spreadsheet ID from its URL) and the tab name
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_TAB=Invoice log

# Run Now: send this in the X-Run-Secret header to start a run by hand
RUN_NOW_SECRET=make-up-another-long-random-string
# The 15 minute schedule runs unless this is false (approval links keep working either way)
SCHEDULE_ENABLED=true

# Limits and retries
MAX_MESSAGES_PER_RUN=10
# PDFs larger than this go to a person (at most 20: base64 adds a third and Anthropic takes 32 MB per request)
MAX_PDF_MB=10
# Runs to retry a PDF after Claude or QuickBooks failures before it goes to a person
MAX_EXTRACT_ATTEMPTS=3
# Tries per Claude or QuickBooks call inside one run, with exponential backoff from RETRY_BASE_SECONDS
API_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
# Wait after a QuickBooks 429 when no Retry-After header comes back (Intuit asks for 60 seconds)
QBO_RATE_LIMIT_WAIT_SECONDS=60

# Checks
DUE_DATE_MAX_DAYS=120
INVOICE_MAX_AGE_DAYS=365
BUSINESS_TZ=America/New_York

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
